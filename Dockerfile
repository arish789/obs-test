# Dockerfile generated by DevOpsArk
# Use the Node version specified in the package.json engines field
FROM node:20-slim AS builder

# Set the working directory
WORKDIR /app

# Copy package.json and package-lock.json first for better caching
COPY package.json package-lock.json ./

# Install dependencies
RUN npm install

# Copy the rest of the application source code
COPY . .

# Expose the port the app listens on
EXPOSE 5002

# Command to run the application

# >>> DevOpsArk Observability Start >>>
RUN mkdir -p /opt/devopsark \
    && node -e "require('fs').writeFileSync('/opt/devopsark/console-hook.cjs', Buffer.from('', 'base64'))" \
    && cd /opt/devopsark \
    && npm init -y >/dev/null 2>&1 \
    && npm install --no-audit --no-fund --loglevel=error @opentelemetry/auto-instrumentations-node @opentelemetry/api @opentelemetry/core \
    && chmod -R a+rX /opt/devopsark
ENV NODE_PATH="/opt/devopsark/node_modules"
ENV OTEL_TRACES_EXPORTER="otlp" OTEL_METRICS_EXPORTER="otlp" OTEL_LOGS_EXPORTER="none" OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf" OTEL_BSP_SCHEDULE_DELAY="1000" NODE_TLS_REJECT_UNAUTHORIZED="0"
ENV NODE_OPTIONS="--require /opt/devopsark/console-hook.cjs"
# <<< DevOpsArk Observability End <<<

CMD ["npm", "start"]