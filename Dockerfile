# Dockerfile generated by DevOpsArk ArkBuilder
FROM node:20-slim

WORKDIR /app

# 1. Zero-touch Observability: Install OpenTelemetry globally in the image
RUN npm install -g @opentelemetry/auto-instrumentations-node
ENV NODE_PATH="/usr/local/lib/node_modules"

# 2. Copy user package manifests and install pure user dependencies
COPY package*.json ./
RUN npm install --production

# 3. Copy application source
COPY . .

EXPOSE 5001

CMD ["npm", "start"]
