FROM python:3.11-slim

WORKDIR /app

# DevOpsArk Platform Layer: Zero-Touch OpenTelemetry (Python)
RUN pip install --no-cache-dir opentelemetry-distro opentelemetry-exporter-otlp opentelemetry-instrumentation

