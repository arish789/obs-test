{
  "name": "obs-testing",
  "version": "1.0.0",
  "description": "Realistic customer-like API for DevOpsArk Observability testing",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test:workload": "node -e 'require(\"http\").get(\"http://127.0.0.1:\" + (process.env.PORT || 5002) + \"/api/workload/run\", (res) => res.pipe(process.stdout))'"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "@opentelemetry/sdk-node": "^0.52.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.52.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.52.0",
    "@opentelemetry/sdk-metrics": "^1.22.0",
    "@opentelemetry/sdk-logs": "^0.52.0",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@opentelemetry/api-logs": "^0.52.0",
    "@opentelemetry/auto-instrumentations-node": "^0.40.0",
    "@opentelemetry/resources": "^1.22.0",
    "@opentelemetry/semantic-conventions": "^1.22.0",
    "@opentelemetry/api": "^1.8.0",
    "winston": "^3.11.0",
    "winston-transport": "^4.5.0",
    "dotenv": "^16.3.1"
  }
}