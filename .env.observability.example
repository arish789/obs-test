# DevOpsArk observability (injected) — copy to .env and adjust
# OTLP (logs/traces/metrics export). Do not put /metrics on OTEL_EXPORTER_OTLP_ENDPOINT.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel.devopsark.com

# Prometheus scrape (collector /metrics)
OTEL_COLLECTOR_METRICS_URL=http://otel.devopsark.com/metrics

# Optional explicit public vs in-cluster (used when KUBERNETES_SERVICE_HOST is set)
DEVOPSARK_OTEL_COLLECTOR_OTLP_URL_PUBLIC=http://otel.devopsark.com
# DEVOPSARK_OTEL_COLLECTOR_OTLP_URL_CLUSTER=http://otel-collector.devopsark-namespace.svc.cluster.local:4318
DEVOPSARK_OTEL_COLLECTOR_METRICS_URL_PUBLIC=http://otel.devopsark.com/metrics
# DEVOPSARK_OTEL_COLLECTOR_METRICS_URL_CLUSTER=http://otel-collector.devopsark-namespace.svc.cluster.local:8889/metrics

OTEL_SERVICE_NAME="arkrn:project:73bac4b6-4684-44cb-8c97-67aa4d9a5587:observabilityIntegration:be2ac28e-5e7e-42f0-9189-04619515877f"
OTEL_EXPORT_BATCH_DELAY_MS=300
LOG_LEVEL=info

# Pipeline debug (console): app OTLP export → collector
# DEVOPSARK_OBSERVABILITY_DEBUG=true
