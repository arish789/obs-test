# Application Port
PORT=5002

# Service Name as it will appear in DevOpsArk Observability Dashboard
OTEL_SERVICE_NAME=my-node-service

# Base OTLP receiver endpoint (DevOpsArk Master GraphQL)
OTEL_EXPORTER_OTLP_ENDPOINT=http://<DEVOPSARK_HOST>:4000/v1/observability
OTEL_EXPORTER_OTLP_PROTOCOL=http/json

# Project integration credentials (obtained from DevOpsArk UI when integrating project)
OTEL_EXPORTER_OTLP_HEADERS=x-api-key=<YOUR_OBSERVABILITY_API_KEY>,x-organisation-id=<YOUR_ORGANISATION_ID>,x-project-id=<YOUR_PROJECT_ID>

# Runtime OpenTelemetry & DevOpsArk Platform Hook injection (automatically configured by ArkBuilder inside the container)
# NODE_OPTIONS="--require @opentelemetry/auto-instrumentations-node/register --require /opt/devopsark/console-hook.cjs"
